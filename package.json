{
  "name": "openapi-docs",
  "version": "0.0.5",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valerii15298/openapi-docs.git"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "typings": "./src/index.d.ts",
  "imports": {
    "#*": "./src/*.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./const": "./src/const.js",
    "./types": "./src/types/index.js",
    "./workers/*.js": "./src/workers/*.worker.js"
  },
  "sideEffects": [
    "./src/json-editor/monaco.*"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp -r README.md package.json dist",
    "release": "pnpm build && cd dist && pnpm publish --access public",
    "release:surge": "rm -rf dist && vite build && surge --domain stimulating-sock-openapi-test.surge.sh ./dist && open https://stimulating-sock-openapi-test.surge.sh",
    "release:netlify": "rm -rf dist && vite build && ntl deploy -p -d dist --no-build -s openapi-ui --open"
  },
  "dependencies": {
    "@types/content-type": "^1.1.9",
    "allof-merge": "^0.6.7",
    "content-type": "^1.0.5",
    "marked": "^17.0.1",
    "monaco-yaml": "^5.4.0",
    "openapi-sampler": "^1.6.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tsconfig/strictest": "^2.0.6",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vpetryniak/eslint-config-base": "^0.0.17",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "netlify-cli": "^23.12.3",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "surge": "^0.24.6",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@latest"
  },
  "peerDependencies": {
    "@sane-ts/shadcn-ui": "^0.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "engines": {
    "node": "24",
    "pnpm": "10.19.0"
  },
  "packageManager": "pnpm@10.19.0"
}
